# Backend mode: 'sqlite' (local development) | 'clickhouse' (production on orc)
KEYLOGGER_BACKEND=sqlite

# SQLite path (used when BACKEND=sqlite, defaults to ~/.local/share/rust-keylogger/keylog.db)
# KEYLOGGER_DB_PATH=/home/daniel/.local/share/rust-keylogger/keylog.db

# ClickHouse HTTP API (used when BACKEND=clickhouse)
# When running in Docker on orc, use container name:
# CLICKHOUSE_URL=http://signoz-telemetrystore-clickhouse-0-0:8123
# When accessing from outside Docker (tailscale):
# CLICKHOUSE_URL=http://100.72.165.110:8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=signoz_logs

# Port for the SvelteKit server (default: 3000 locally, 3002 on orc)
# PORT=3002
